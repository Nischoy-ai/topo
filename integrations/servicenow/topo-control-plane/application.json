{
  "name": "Nischoy Topo",
  "scope": "x_664635_topo",
  "version": "0.4.4",
  "description": "ServiceNow-owned control plane for stateless Nischoy Topo workers",
  "source": {
    "format": "servicenow_fluent",
    "sdk_version": "4.9.0",
    "config": "now.config.json",
    "directory": "src/fluent"
  },
  "roles": [
    "x_664635_topo.admin",
    "x_664635_topo.credential_admin",
    "x_664635_topo.operator",
    "x_664635_topo.viewer",
    "x_664635_topo.worker"
  ],
  "script_includes": [
    {
      "name": "TopoControlPlane",
      "access": "package_private",
      "client_callable": false,
      "script": "scripts/TopoControlPlane.js"
    },
    {
      "name": "TopoObservationMapper",
      "access": "package_private",
      "client_callable": false,
      "script": "scripts/TopoObservationMapper.js"
    },
    {
      "name": "TopoIREProcessor",
      "access": "package_private",
      "client_callable": false,
      "script": "scripts/TopoIREProcessor.js"
    }
  ],
  "scripted_rest_api": {
    "name": "Topo Worker API",
    "api_id": "tasks",
    "base_path": "/api/x_664635_topo/v1/tasks",
    "requires_authentication": true,
    "required_role": "x_664635_topo.worker",
    "resources": [
      {"name": "Register worker", "method": "POST", "path": "/workers/register", "script": "scripts/register_worker.js"},
      {"name": "Worker heartbeat", "method": "POST", "path": "/workers/heartbeat", "script": "scripts/worker_heartbeat.js"},
      {"name": "Claim task", "method": "POST", "path": "/claim", "script": "scripts/claim_task.js"},
      {"name": "Renew task lease", "method": "POST", "path": "/{id}/renew", "script": "scripts/renew_task.js"},
      {"name": "Retrieve attempt-bound task credential", "method": "POST", "path": "/{id}/credential", "script": "scripts/credential_task.js"},
      {"name": "Ingest result chunk", "method": "POST", "path": "/{id}/results", "script": "scripts/ingest_result.js"},
      {"name": "Complete task", "method": "POST", "path": "/{id}/complete", "script": "scripts/complete_task.js"}
    ],
    "oauth_policy": {
      "grant_only_scripted_resources": true,
      "deny_table_api": true,
      "deny_cmdb_api": true,
      "deny_ire_api": true
    }
  },
