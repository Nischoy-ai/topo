# Copy to /etc/topo-agent/topo-agent.env, restrict to root:topo-agent 0640,
# and set the controller URL for your environment. Secrets do not belong in
# this file; the unit passes -api-key-ref and -spool-key-ref as file:
# references to /etc/topo-agent/api-key and /etc/topo-agent/spool-key
# instead. See docs/topo-agent.md.

TOPO_AGENT_CONTROLLER_URL=https://topo-hub.internal:8443
