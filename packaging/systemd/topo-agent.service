[Unit]
Description=Topo Agent - outbound-only endpoint discovery agent
Documentation=https://github.com/Nischoy-ai/topo/blob/main/docs/topo-agent.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=topo-agent
Group=topo-agent

# Non-secret configuration. See topo-agent.env.example.
EnvironmentFile=/etc/topo-agent/topo-agent.env

# Secret references are file: paths rather than embedded values; see
# docs/topo-agent.md for how to populate /etc/topo-agent/api-key and
# /etc/topo-agent/spool-key.
ExecStart=/usr/local/bin/topo agent run \
    -controller-url ${TOPO_AGENT_CONTROLLER_URL} \
    -api-key-ref file:/etc/topo-agent/api-key \
    -spool-dir /var/lib/topo-agent/spool \
    -spool-key-ref file:/etc/topo-agent/spool-key

Restart=on-failure
RestartSec=30
TimeoutStopSec=30

# systemd creates and owns these directories for the service user; the
# agent creates its own spool subdirectory inside the state directory.
StateDirectory=topo-agent
StateDirectoryMode=0750

# Hardening. Adjust ProtectSystem/ProtectHome if your deployment needs a
# path this unit does not already grant.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
