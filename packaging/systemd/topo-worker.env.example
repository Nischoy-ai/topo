# Copy to /etc/topo-worker/topo-worker.env and restrict to root:topo-worker
# 0640. This file is deliberately non-secret. The bearer token belongs in
# /etc/topo-worker/worker-token with root:topo-worker 0640 permissions.

SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
TOPO_WORKER_POOL=replace-with-worker-pool-id
TOPO_WORKER_SITE=replace-with-site-id
TOPO_WORKER_MAX_CONCURRENCY=2
