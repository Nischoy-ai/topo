#!/usr/bin/make -f
export PATH := /usr/lib/go-1.27/bin:/usr/lib/go-1.26/bin:$(PATH)
export GO111MODULE := on
export GOTOOLCHAIN := local
export GOPROXY := off
export GOSUMDB := off
export GOMAXPROCS := 2
# dh-go does not discover the nested v5 module beneath this legacy v4 root.
export DH_GOLANG_MODULE_MAPPINGS := github.com/evanphx/json-patch/v5:github.com/evanphx/json-patch/v5
export DH_GOLANG_BUILDPKG := github.com/Nischoy-ai/topo/cmd/topo
# Tests read reviewed units, workflow fixtures and ServiceNow application files.
export DH_GOLANG_INSTALL_EXTRA := packaging scripts .github integrations docs examples README.md ROADMAP.md SECURITY.md

%:
	dh $@ --with=golang --builddirectory=_build --buildsystem=golang

override_dh_auto_configure:
	test ! -d vendor
	case "$$(go env GOVERSION)" in go1.26.9|go1.27.2) ;; *) echo "Unqualified downstream Go compiler" >&2; exit 1 ;; esac
	# dh-go constructs the workspace from module roots, then builds only the CLI.
	DH_GOLANG_BUILDPKG=github.com/Nischoy-ai/topo/... dh_auto_configure
	python3 debian/fix-module-metadata.py _build
	# Debian client-go imports v5 while its packaged go.mod still lists v4.
	# Add the installed v5 requirement only to the private downstream build copy.
	cd _build/src/github.com/Nischoy-ai/topo && GOWORK=off go mod edit -require=github.com/evanphx/json-patch/v5@v5.7.0

override_dh_auto_build:
	dh_auto_build -- -trimpath -ldflags="-X main.version=0.4.7-debiansnapshot.3adbdb3"
	cd _build && CGO_ENABLED=0 go build -trimpath -o topo-setup-controlsim ../debian/fixtures/setupcontrolsim/main.go

override_dh_auto_test:
	cd _build/src/github.com/Nischoy-ai/topo && GOWORK=$(CURDIR)/_build/go.work GOPATH=$(CURDIR)/_build GOCACHE=$(CURDIR)/_build/go-build go vet ./...
	DH_GOLANG_BUILDPKG=github.com/Nischoy-ai/topo/... dh_auto_test -- -race -timeout 10m

override_dh_auto_install:
	dh_auto_install -- --no-source

override_dh_installsystemd:
	dh_installsystemd --name=topo-worker --no-enable --no-start
	dh_installsystemd --name=topo-agent --no-enable --no-start

override_dh_installdocs:
	python3 debian/collect-linked-copyright.py _build debian/topo/usr/share/doc/topo/linked-licenses
	dh_installdocs

override_dh_compress:
	dh_compress -Xlinked-licenses
