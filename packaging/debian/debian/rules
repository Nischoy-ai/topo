#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

# golang-1.26-go and golang-1.27-go do not install /usr/bin/go.
export PATH := /usr/lib/go-1.27/bin:/usr/lib/go-1.26/bin:$(PATH)
export GO111MODULE := on
export GOTOOLCHAIN := local
export GOPROXY := off
export GOSUMDB := off
export DH_GOLANG_BUILDPKG := github.com/Nischoy-ai/topo/cmd/topo
# Tests read the systemd units, workflow fixtures and ServiceNow application files.
export DH_GOLANG_INSTALL_EXTRA := packaging scripts .github integrations docs examples README.md ROADMAP.md SECURITY.md
# dh-go does not discover the nested json-patch v5 module beneath the v4 root.
export DH_GOLANG_MODULE_MAPPINGS := github.com/evanphx/json-patch/v5:github.com/evanphx/json-patch/v5

%:
	dh $@ --with=golang --builddirectory=_build --buildsystem=golang

override_dh_auto_configure:
	DH_GOLANG_BUILDPKG=github.com/Nischoy-ai/topo/... dh_auto_configure
	# Workaround: the installed go-flowrate source has no go.mod.
	python3 debian/fix-module-metadata.py _build
	# Workaround: Debian client-go imports json-patch v5 but its go.mod lists v4.
	cd _build/src/github.com/Nischoy-ai/topo && GOWORK=off go mod edit -require=github.com/evanphx/json-patch/v5@v5.7.0

override_dh_auto_build:
	dh_auto_build -- -trimpath -ldflags="-X main.version=$(DEB_VERSION_UPSTREAM)"

override_dh_auto_test:
	DH_GOLANG_BUILDPKG=github.com/Nischoy-ai/topo/... dh_auto_test

override_dh_auto_install:
	dh_auto_install -- --no-source

override_dh_installsystemd:
	dh_installsystemd --name=topo-worker --no-enable --no-start --no-stop-on-upgrade
	dh_installsystemd --name=topo-agent --no-enable --no-start --no-stop-on-upgrade
