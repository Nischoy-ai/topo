#!/usr/bin/make -f
export PATH := /usr/lib/go-1.27/bin:/usr/lib/go-1.26/bin:$(PATH)
export GOTOOLCHAIN := local
export GOPROXY := off
export GOSUMDB := off
export GOMAXPROCS := 2
export DH_GOLANG_BUILDPKG := github.com/Nischoy-ai/topo/cmd/topo
# Tests read reviewed units, workflow fixtures and ServiceNow application files.
export DH_GOLANG_INSTALL_EXTRA := packaging scripts .github integrations docs README.md ROADMAP.md SECURITY.md

%:
	dh $@ --builddirectory=_build --buildsystem=golang

override_dh_auto_configure:
	test ! -d vendor
	case "$$(go env GOVERSION)" in go1.26.9|go1.27.2) ;; *) echo "Unqualified downstream Go compiler" >&2; exit 1 ;; esac
	dh_auto_configure

override_dh_auto_build:
	dh_auto_build -- -trimpath -ldflags="-X main.version=0.4.7-debiansnapshot.3adbdb3"

override_dh_auto_test:
	DH_GOLANG_BUILDPKG=github.com/Nischoy-ai/topo/... dh_auto_test -- -timeout 10m

override_dh_auto_install:
	dh_auto_install -- --no-source

override_dh_installsystemd:
	dh_installsystemd --name=topo-worker --no-enable --no-start
	dh_installsystemd --name=topo-agent --no-enable --no-start
